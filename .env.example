# Everything is optional for local use. Copy to .env to change a value.

# Paste your Nebius key here to turn on the live assistant.
# Left empty, the assistant uses the scripted fallback for the demo question.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any tool-calling model from your Nebius catalog, with its organisation prefix.
NEBIUS_MODEL=openai/gpt-oss-120b

DATABASE_URL=postgres://analytics:analytics@localhost:5433/analytics
DATABASE_URL_READONLY=postgres://analytics_ro:analytics_ro@localhost:5433/analytics
WRITE_KEY=demo_write_key
PORT=4000
